# ==============================================================================
# Google Cloud Platform (ADC & Client Libraries)
# ==============================================================================
# Standard variables automatically read by google-cloud-* Python SDKs
GOOGLE_CLOUD_PROJECT=incident-triage-agent-513309
GCP_PROJECT=incident-triage-agent-513309
GCP_REGION=asia-south1

# Optional: Path to service account key file (leave empty if using user ADC: gcloud auth application-default login)
GOOGLE_APPLICATION_CREDENTIALS=

# ==============================================================================
# Terraform CLI Environment Variables (TF_VAR_<var_name>)
# ==============================================================================
TF_VAR_project_id=incident-triage-agent-513309
TF_VAR_region=asia-south1
TF_VAR_billing_account=YOUR_BILLING_ACCOUNT_ID

# ==============================================================================
# BigQuery Datasets
# ==============================================================================
BQ_DATASET_RAW=raw
BQ_DATASET_CORE=core
BQ_DATASET_OPS=ops
BQ_DATASET_EVAL=triage_eval

# ==============================================================================
# Cloud Storage & Pub/Sub
# ==============================================================================
GCS_RAW_BUCKET=incident-triage-agent-513309-weather-data
PUBSUB_RUN_EVENTS_TOPIC=triage-run-events
PUBSUB_INCIDENTS_TOPIC=triage-incidents

# ==============================================================================
# Model Routing & Dual-Adapter LLM Configuration
# ==============================================================================
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=false
DEFAULT_ROUTING_POLICY=tiered
